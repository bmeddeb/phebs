{
  "$defs": {
    "capability_predicate": {
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "requires_all": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "requires_any": {
              "minItems": 1
            }
          }
        }
      ],
      "properties": {
        "requires_all": {
          "items": {
            "enum": [
              "caller-map-exact-identity",
              "code-navigation",
              "contract-atlas",
              "contract-impact-report",
              "coverage-certificate",
              "history",
              "service-catalog-v2",
              "service-relationships-v1",
              "source-search"
            ]
          },
          "maxItems": 64,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "requires_any": {
          "items": {
            "enum": [
              "caller-map-exact-identity",
              "code-navigation",
              "contract-atlas",
              "contract-impact-report",
              "coverage-certificate",
              "history",
              "service-catalog-v2",
              "service-relationships-v1",
              "source-search"
            ]
          },
          "maxItems": 64,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "unavailable_help": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "requires_all",
        "requires_any",
        "unavailable_help"
      ],
      "type": "object"
    },
    "term": {
      "additionalProperties": false,
      "properties": {
        "authority_boundary": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "availability": {
          "$ref": "#/$defs/capability_predicate"
        },
        "evidence_boundary": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "expanded_help": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "enum": [
            "analysis_scope_and_gaps",
            "could_not_resolve",
            "coverage_certificate",
            "exact_static_relationship",
            "implementation_evidence",
            "matching_static_evidence",
            "name_match_needing_review",
            "resolved_caller",
            "service_catalog_authority"
          ]
        },
        "label": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "short_help": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "surfaces": {
          "items": {
            "enum": [
              "atlas",
              "blame",
              "caller_map",
              "commit",
              "file",
              "history",
              "impact",
              "manual",
              "mcp",
              "relationship_explorer",
              "service_directory"
            ]
          },
          "maxItems": 11,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "wire_aliases": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]{0,127}$",
            "type": "string"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "label",
        "short_help",
        "expanded_help",
        "evidence_boundary",
        "authority_boundary",
        "surfaces",
        "wire_aliases",
        "availability"
      ],
      "type": "object"
    }
  },
  "$id": "urn:phebs:schema:phebs-evidence-glossary-v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {
        "enum": [
          "caller-map-exact-identity",
          "code-navigation",
          "contract-atlas",
          "contract-impact-report",
          "coverage-certificate",
          "history",
          "service-catalog-v2",
          "service-relationships-v1",
          "source-search"
        ]
      },
      "maxItems": 9,
      "minItems": 9,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "phebs-evidence-glossary-v2"
    },
    "terms": {
      "items": {
        "$ref": "#/$defs/term"
      },
      "maxItems": 9,
      "minItems": 9,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "capabilities",
    "terms"
  ],
  "title": "phebs evidence glossary v2",
  "type": "object"
}
