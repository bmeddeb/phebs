  "conditional_rules": {
    "Set": "SET prefix always; expiration only adds EX/PX/KEEPTTL, never GET. Resolve OW/UPDATE from pinned variable-flags note/public key-spec documentation. Unknown non-key data does not fabricate a concrete key.",
    "SetNX": "This spike admits only literal expiration0 (SETNX). Other expiration branches remain opaque-helper rather than guess SET NX.",
    "ZAddXX": "Verified wrapper calls ZAddArgs with XXtrue and caller Members; exact key stays arg1. Shared helper prepends ZADD, never shifts key.",
    "Script.Run": "Excluded as opaque-helper: fallback EVALSHA/EVAL and script body are not an admitted explicit EVAL vector.",
    "PubSub": "SUBSCRIBE/PUBLISH operands are channels, not keys; no key/resource/value-kind fact.",
    "ClusterKeySlot": "Routing argument is not a key-spec usage in frozen metadata; no key existence fact."
  },
  "unlisted_methods": "unknown-client-adapter; no CamelCase-to-uppercase inference",
  "script_passthrough": "Explicit Eval/EvalSha/FCall keys[] literal or same-file immutable array, fixed count and exact key spans only; emits PASSES_REDIS_KEY_TO_SCRIPT, suppresses generic metadata access/kind.",
