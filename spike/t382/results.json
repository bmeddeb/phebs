  "cases": [
    {
      "name": "source_first_filters",
      "assertions": [
        "service_required",
        "repository_optional",
        "direction_kind_plane_lookup_exact",
        "cursor_query_bound"
      ],
      "gates": [
        "maps repository, direction, evidence, and exact contract filters into one bounded reader query"
      ]
    },
    {
      "name": "broad_fallback_and_coverage",
      "assertions": [
        "authorization_first_visible_repository_fallback",
