      "gates": [
        "uses broad authorized fallback and shares deterministic ids between exact rows and the optional diagram",
        "TestRelationshipServiceAuthorizationGapAndRetainedProofShape"
      ]
    },
    {
      "name": "deterministic_page_diagram",
      "assertions": [
        "table_and_diagram_ids_equal",
