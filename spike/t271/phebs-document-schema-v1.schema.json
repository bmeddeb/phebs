{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phebs.com/schemas/phebs-document-schema-v1.json",
  "title": "phebs-document-schema-v1",
  "$comment": "Spike-only contract. README.md defines byte/depth/aggregate/reference/order/duplicate/payload refusal requirements not expressible by this structural schema. No vendor/runtime schema validation is claimed.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "phebs-document-schema-v1"
    },
    "source_class": {
      "enum": [
        "authored",
        "captured"
      ]
    },
    "tables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/table"
      },
      "minItems": 0,
      "maxItems": 16
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/view"
      },
      "minItems": 0,
      "maxItems": 16
    }
  },
  "required": [
    "format",
    "source_class",
    "tables",
    "views"
  ],
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "opaque_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "segment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "field"
            },
            "name": {
              "$ref": "#/$defs/name"
            }
          },
          "required": [
            "kind",
            "name"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "array_element",
                "map_value"
              ]
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "path": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      },
      "minItems": 1,
      "maxItems": 8
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "type": {
          "$ref": "#/$defs/opaque_type"
        }
      },
      "required": [
        "path",
        "type"
      ]
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "direction": {
          "enum": [
            "asc",
            "desc"
          ],
          "default": "asc"
        }
      },
      "required": [
        "path"
      ]
    },
    "index_column": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "direction": {
          "enum": [
            "asc",
            "desc"
          ],
          "default": "asc"
        },
        "prefix_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "prefix_unit": {
          "$ref": "#/$defs/name"
        }
      },
      "required": [
        "path"
      ],
      "dependentRequired": {
        "prefix_length": [
          "prefix_unit"
        ],
        "prefix_unit": [
          "prefix_length"
        ]
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "kind": {
          "$ref": "#/$defs/name"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/index_column"
          },
          "minItems": 1,
          "maxItems": 8
        }
      },
      "required": [
        "name",
        "kind",
        "columns"
      ]
    },
    "association_pair": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/path"
        },
        "target": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "source",
        "target"
      ]
    },
    "association": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "target": {
          "$ref": "#/$defs/name"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/association_pair"
          },
          "minItems": 1,
          "maxItems": 8
        }
      },
      "required": [
        "name",
        "target",
        "fields"
      ]
    },
    "view_source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "table",
            "view"
          ]
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "path": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "kind",
        "name",
        "path"
      ]
    },
    "view_field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "type": {
          "$ref": "#/$defs/opaque_type"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/view_source"
          },
          "minItems": 0,
          "maxItems": 16
        }
      },
      "required": [
        "name",
        "type",
        "sources"
      ]
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          },
          "minItems": 1,
          "maxItems": 128
        },
        "primary_key": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "partition_key": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "indexes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/index"
          },
          "minItems": 0,
          "maxItems": 16
        },
        "associations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/association"
          },
          "minItems": 0,
          "maxItems": 64
        }
      },
      "required": [
        "name",
        "fields",
        "primary_key",
        "indexes",
        "associations"
      ]
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/view_field"
          },
          "minItems": 1,
          "maxItems": 128
        },
        "primary_key": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "partition_key": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "indexes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/index"
          },
          "minItems": 0,
          "maxItems": 16
        }
      },
      "required": [
        "name",
        "fields",
        "primary_key",
        "indexes"
      ]
    }
  }
}
